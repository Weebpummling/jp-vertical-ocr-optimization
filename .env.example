# Copy to .env (gitignored) and fill in.
#
# There is no database server and no password: the database is a single SQLite
# file (docs/SETUP.md). By default it sits in the data home as
# officer-index.db; set JPOCR_DB to put it somewhere else, such as a shared
# folder.

# Private data home on this machine (see docs/data-home.md). Code reads this env var;
# absolute paths must never be hardcoded in committed code.
JP_OCR_DATA=C:\Users\<you>\jp-ocr-data

# Optional: full path to the database file, if not <data home>\officer-index.db
# JPOCR_DB=C:\Users\<you>\jp-ocr-data\officer-index.db
